{
  "name": "risques-majeurs-mcp",
  "version": "1.0.0",
  "description": "Serveur MCP d'exposition aux risques majeurs en France",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "risques-majeurs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "license",
    "readme.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && cross-env INPUT=client/mcp-app.html vite build",
    "start-dev": "concurrently \"tsx watch server/index.ts\" \"cross-env NODE_ENV=development INPUT=client/mcp-app.html vite build --watch\"",
    "start-dev-stdio": "tsx watch server/index.ts --stdio",
    "start": "concurrently \"tsx watch server/index.ts\" \"cross-env INPUT=client/mcp-app.html vite build --watch\"",
    "start-stdio": "node dist/index.js --stdio",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@turf/turf": "^7.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "maplibre-gl": "^6.19.0",
    "maplibre-ui-translations": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
